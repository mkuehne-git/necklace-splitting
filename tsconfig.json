{
  // Type checking only (`npm run typecheck`, strict since v1.2.2): Vite builds without it.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client", "vite-plugin-pwa/client", "node"],
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "resolveJsonModule": true
  },
  "include": ["src", "test", "e2e", "screenshots", "glsl.d.ts", "vite-env.d.ts", "vite.config.ts", "playwright.config.ts", "playwright.screenshots.config.ts"]
}
